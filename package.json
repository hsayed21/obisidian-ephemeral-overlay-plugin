{
	"name": "obsidian-ephemeral-overlay-plugin",
	"version": "1.1.0",
	"description": "Temporary drawing overlay for freehand annotations with mouse, touch, or Apple Pencil. Like ZoomIt or Epic Pen - nothing saved to disk.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node scripts/test.mjs",
		"verify-release": "node scripts/validate-release.mjs",
		"check": "npm test && npm run lint && npm run build && npm run verify-release",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hsayed21/obsidian-ephemeral-overlay-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/hsayed21/obsidian-ephemeral-overlay-plugin/issues"
	},
	"homepage": "https://github.com/hsayed21/obsidian-ephemeral-overlay-plugin#readme",
	"keywords": [
		"obsidian",
		"apple-pencil",
		"drawing",
		"annotation",
		"ipad"
	],
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"@eslint/js": "9.30.1",
		"jiti": "2.6.1",
		"obsidian": "latest"
	}
}
